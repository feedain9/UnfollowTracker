{
  "name": "unfollowtracker",
  "version": "1.1.0",
  "description": "Compare current Instagram followers and following in a persistent browser side panel",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "build": "npm run build:site && npm run package:extension",
    "lint": "eslint src/ tests/ scripts/build-site.js scripts/serve-site.js site/*.js site/assets/*.js scripts/generate-store-assets.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-smoke.js",
    "test:avatars": "node tests/avatars-browser.js",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "build:site": "node scripts/build-site.js",
    "build:site:production": "node scripts/build-site.js --production",
    "site:dev": "npm run build:site && node scripts/serve-site.js",
    "package:extension": "python3 scripts/package-extension.py",
    "test:site": "node tests/site-smoke.js",
    "assets:store": "node scripts/generate-store-assets.js"
  },
  "keywords": [
    "instagram",
    "unfollowers",
    "chrome-extension",
    "social-media"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "canvas": "^2.11.2",
    "eslint": "^8.57.0",
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0",
    "prettier": "^3.2.5"
  }
}
